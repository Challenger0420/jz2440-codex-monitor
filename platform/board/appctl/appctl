#!/bin/sh

# Generic JZ2440 foreground application launcher.
# Runtime state is volatile and lives below /tmp, not on YAFFS.
ROOT=/opt/jz2440
APPS="$ROOT/apps"
STATE=/tmp/jz2440
CURRENT_APP="$STATE/current-app"
CURRENT_PID="$STATE/current-pid"

mkdir_state()
{
    if [ ! -d "$STATE" ]; then mkdir -p "$STATE" || return 1; fi
}

process_exists()
{
    PID="$1"
    case "$PID" in ''|*[!0-9]*) return 1 ;; esac
    ps 2>/dev/null | grep -v grep | grep -q " $PID "
}

qtopia_running()
{
    ps 2>/dev/null | grep -v grep | grep -q '/opt/Qtopia/bin/qpe'
}

today_running()
{
    ps 2>/dev/null | grep -v grep | grep -q '/opt/Qtopia/bin/today'
}

restore_qtopia()
{
    if ! qtopia_running; then /bin/qpe.sh & sleep 2; fi
    if ! today_running; then
        QTDIR=/opt/Qtopia QPEDIR=/opt/Qtopia \
        QWS_DISPLAY=LinuxFb:/dev/fb0 QWS_KEYBOARD=TTY:/dev/tty1 \
        QWS_MOUSE_PROTO=TPanel:/dev/ts0 TSLIB_TSDEVICE=/dev/ts0 \
        TSLIB_CONSOLEDEVICE=none TSLIB_FBDEVICE=/dev/fb0 \
        TSLIB_CONFFILE=/etc/ts.conf TSLIB_PLUGINDIR=/usr/share/ts/plugins \
        TSLIB_TSEVENTTYPE=H3600 LD_LIBRARY_PATH=/opt/Qtopia/lib:$LD_LIBRARY_PATH \
        /opt/Qtopia/bin/today &
    fi
}

clear_state()
{
    rm -f "$CURRENT_APP" "$CURRENT_PID"
}

config_value()
{
    FILE="$1"
    KEY="$2"
    VALUE=`sed -n "s/^$KEY=//p" "$FILE" | head -1`
    VALUE=${VALUE#\"}
    VALUE=${VALUE%\"}
    printf '%s' "$VALUE"
}

load_app()
{
    APP="$1"
    CONF="$APPS/$APP/app.conf"
    if [ ! -f "$CONF" ]; then echo "app not registered: $APP" >&2; return 1; fi
    APP_NAME=`config_value "$CONF" APP_NAME`
    APP_EXEC=`config_value "$CONF" APP_EXEC`
    APP_ARGS=`config_value "$CONF" APP_ARGS`
    APP_PROTOCOL=`config_value "$CONF" APP_PROTOCOL`
    if [ "$APP_NAME" != "$APP" ] || [ -z "$APP_EXEC" ] || [ -z "$APP_PROTOCOL" ]; then
        echo "invalid app.conf: $CONF" >&2
        return 1
    fi
    case "$APP_EXEC" in
        /*) ;;
        *) echo "APP_EXEC must be an absolute path" >&2; return 1 ;;
    esac
    case "$APP_ARGS" in
        *[!A-Za-z0-9_./:=\ -]*) echo "unsafe APP_ARGS in $CONF" >&2; return 1 ;;
    esac
    if [ ! -x "$APP_EXEC" ]; then echo "app executable missing: $APP_EXEC" >&2; return 1; fi
    return 0
}

list_apps()
{
    FOUND=0
    for DIR in "$APPS"/*; do
        [ -f "$DIR/app.conf" ] || continue
        NAME=`config_value "$DIR/app.conf" APP_NAME`
        [ -n "$NAME" ] && { echo "$NAME"; FOUND=1; }
    done
    return 0
}

cleanup_after_app()
{
    clear_state
    restore_qtopia
}

start_app()
{
    APP="$1"
    mkdir_state || exit 1
    if [ -f "$CURRENT_PID" ]; then
        PID=`cat "$CURRENT_PID" 2>/dev/null`
        if process_exists "$PID"; then echo "APP $APP already blocked by PID=$PID" >&2; return 1; fi
        clear_state
    fi
    load_app "$APP" || return 1
    if qtopia_running; then killall qpe qss today quicklauncher 2>/dev/null; sleep 1; fi
    echo "$APP_NAME" > "$CURRENT_APP" || return 1
    echo "$$" > "$CURRENT_PID" || { clear_state; restore_qtopia; return 1; }
    trap 'cleanup_after_app; printf "<APPSTOP|%s|RC=143>\n" "$APP_NAME"; exit 143' HUP INT TERM
    printf '<APPREADY|%s>\n' "$APP_NAME"
    set -f
    set -- $APP_ARGS
    "$APP_EXEC" "$@"
    RC=$?
    trap - HUP INT TERM
    cleanup_after_app
    printf '<APPSTOP|%s|RC=%s>\n' "$APP_NAME" "$RC"
    return "$RC"
}

stop_app()
{
    if [ ! -f "$CURRENT_PID" ]; then cleanup_after_app; return 0; fi
    PID=`cat "$CURRENT_PID" 2>/dev/null`
    if process_exists "$PID"; then
        kill "$PID" 2>/dev/null
        I=0
        while process_exists "$PID"; do
            sleep 1; I=`expr "$I" + 1`
            if [ "$I" -ge 5 ]; then kill -9 "$PID" 2>/dev/null; break; fi
        done
    fi
    cleanup_after_app
}

status_app()
{
    if [ -f "$CURRENT_APP" ] && [ -f "$CURRENT_PID" ]; then
        APP=`cat "$CURRENT_APP" 2>/dev/null`; PID=`cat "$CURRENT_PID" 2>/dev/null`
        if process_exists "$PID"; then echo "APP $APP PID=$PID"; return 0; fi
    fi
    if qtopia_running; then echo QTOPIA; else echo STOPPED; fi
}

case "$1" in
    list) list_apps ;;
    status) status_app ;;
    start)
        [ -n "$2" ] || { echo 'usage: appctl start <app>' >&2; exit 2; }
        start_app "$2"; exit $? ;;
    stop) stop_app ;;
    qtopia)
        if [ -f "$CURRENT_PID" ] && process_exists "`cat "$CURRENT_PID" 2>/dev/null`"; then
            echo 'application is still running; stop it first' >&2; exit 1
        fi
        clear_state; restore_qtopia ;;
    *)
        echo 'usage: appctl {list|status|start <app>|stop|qtopia}' >&2
        exit 2 ;;
esac
